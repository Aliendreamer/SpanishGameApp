{
  "files.exclude": {
    ".bashrc": true,
    ".bash_profile": true,
    ".profile": true,
    ".zshrc": true,
    ".zprofile": true,
    ".gitconfig": true,
    ".ripgreprc": true,
    ".gitmodules": true,
    ".idea": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  }
}
