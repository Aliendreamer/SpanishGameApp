{
  "name": "spanishgameapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.1.0",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.22",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.33",
    "expo-splash-screen": "58.0.15",
    "expo-sqlite": "58.0.18",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@expo/ngrok": "4.1.3",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.21.9",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-expo": "58.0.16",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --tunnel --go",
    "start:dev": "expo start --tunnel --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/vocabulary-import",
    "lint": "expo lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check:pins": "node scripts/check-pins.js",
    "expo:doctor": "expo-doctor",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:pins && pnpm expo:doctor",
    "doctor:android": "node scripts/doctor-android.js",
    "build:development": "pnpm eas build -p android --profile development",
    "build:development:local": "EAS_SKIP_AUTO_FINGERPRINT=1 pnpm eas build -p android --profile development --local --output build/development.apk",
    "build:development:gradle": "scripts/build-gradle.sh development",
    "build:preview": "pnpm eas build -p android --profile preview",
    "build:preview:local": "EAS_SKIP_AUTO_FINGERPRINT=1 pnpm eas build -p android --profile preview --local --output build/preview.apk",
    "build:preview:gradle": "scripts/build-gradle.sh preview",
    "build:production": "pnpm eas build -p android --profile production",
    "build:production:local": "EAS_SKIP_AUTO_FINGERPRINT=1 pnpm eas build -p android --profile production --local --output build/production.aab",
    "build:production:gradle": "scripts/build-gradle.sh production",
    "eas": "pnpm dlx eas-cli@24.7.0",
    "vocab:build": "node --no-warnings=ExperimentalWarning tools/vocabulary-import/src/cli.ts",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/scripts/jest-resolver.js",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|standard-navigation))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.db$": "<rootDir>/scripts/asset-stub.js"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx})": "prettier --write --ignore-unknown"
  }
}
